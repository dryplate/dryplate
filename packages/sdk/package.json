{
	"name": "@dryplate/sdk",
	"version": "0.1.0",
	"license": "MIT",
	"homepage": "https://dryplate.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dryplate/dryplate.git",
		"directory": "packages/sdk"
	},
	"bugs": "https://github.com/dryplate/dryplate/issues",
	"description": "Convert, resize, compress, crop, rotate, blur, watermark, merge and strip metadata from images, in Node and the browser. Reads iPhone HEIC.",
	"type": "module",
	"files": [
		"dist",
		"AUTHORS",
		"THIRD-PARTY-NOTICES.md",
		"licenses"
	],
	"exports": {
		".": {
			"node": "./src/node.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"node": "./dist/node.js",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "vite build && vite build --mode node && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p ."
	},
	"dependencies": {
		"@jsquash/avif": "^2.1.1",
		"@jsquash/jpeg": "^1.6.0",
		"@jsquash/oxipng": "^2.3.0",
		"@jsquash/png": "^3.1.1",
		"@jsquash/resize": "^2.1.1",
		"@jsquash/webp": "^1.5.0",
		"libheif-js": "^1.23.5",
		"sharp": "^0.35.5"
	},
	"devDependencies": {
		"@dryplate/core": "workspace:*",
		"vite": "^8.3.7"
	}
}
