{
	"name": "dryplate",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.34.9",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "pnpm -r build",
		"typecheck": "pnpm -r typecheck",
